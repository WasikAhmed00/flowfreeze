# Local development defaults; never place real credentials here.
APP_ENV=development
DATABASE_URL=sqlite:///./data/flowfreeze.db
RANDOM_SEED=42
# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Production stays read-only unless both flags below are deliberately set.
ENABLE_DEMO_WRITES=false
DEMO_WRITE_KEY=
